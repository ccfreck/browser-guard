{
  "manifest_version": 3,
  "name": "Browser Guard",
  "version": "0.1.0",
  "description": "Warns before sensitive information is submitted to ChatGPT.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["src/detector.js", "src/content.js"],
      "run_at": "document_start"
    }
  ]
}
